import tkinter as tk
from tkinter import ttk, messagebox
import json
import os
from datetime import datetime

class MovieLibrary:
    def __init__(self, root):
        self.root = root
        self.root.title("Movie Library - Личная кинотека")
        self.root.geometry("1100x700")
        self.root.resizable(True, True)

        # Файл для хранения фильмов
        self.movies_file = "movies.json"
        self.movies = self.load_movies()
        
        # Уникальные жанры для фильтрации
        self.genres = self.get_unique_genres()
        
        # Создание интерфейса
        self.create_widgets()
        
        # Отображение всех фильмов
        self.display_movies()

    def load_movies(self):
        """Загрузка фильмов из JSON файла"""
        default_movies = [
            {
                "title": "Побег из Шоушенка",
                "genre": "Драма",
                "year": 1994,
                "rating": 9.5,
                "added_date": "2024-12-25 10:30:00"
            },
            {
                "title": "Крёстный отец",
                "genre": "Криминал",
                "year": 1972,
                "rating": 9.2,
                "added_date": "2024-12-25 10:31:00"
            },
            {
                "title": "Тёмный рыцарь",
                "genre": "Боевик",
                "year": 2008,
                "rating": 9.0,
                "added_date": "2024-12-25 10:32:00"
            },
            {
                "title": "Криминальное чтиво",
                "genre": "Криминал",
                "year": 1994,
                "rating": 8.9,
                "added_date": "2024-12-25 10:33:00"
            },
            {
                "title": "Властелин колец: Возвращение короля",
                "genre": "Фэнтези",
                "year": 2003,
                "rating": 9.0,
                "added_date": "2024-12-25 10:34:00"
            }
        ]
        
        if os.path.exists(self.movies_file):
            try:
                with open(self.movies_file, 'r', encoding='utf-8') as f:
                    movies = json.load(f)
                    if movies:  # Если файл не пустой
                        return movies
            except:
                pass
        
        # Если файла нет или он пустой, создаём с фильмами по умолчанию
        self.save_movies(default_movies)
        return default_movies

    def save_movies(self, movies=None):
        """Сохранение фильмов в JSON файл"""
        if movies is None:
            movies = self.movies
        with open(self.movies_file, 'w', encoding='utf-8') as f:
            json.dump(movies, f, indent=4, ensure_ascii=False)

    def get_unique_genres(self):
        """Получение уникальных жанров из списка фильмов"""
        genres = sorted(set(movie["genre"] for movie in self.movies))
        return ["Все"] + genres

    def create_widgets(self):
        # Основной фрейм с отступами
        main_frame = ttk.Frame(self.root, padding="10")
        main_frame.pack(fill=tk.BOTH, expand=True)

        # ==================== Левая панель - Добавление фильма ====================
        left_frame = ttk.LabelFrame(main_frame, text="Добавить новый фильм", padding="15")
        left_frame.pack(side=tk.LEFT, fill=tk.BOTH, expand=False, padx=(0, 10))

        # Поле Название
        ttk.Label(left_frame, text="Название фильма:", font=("Arial", 10, "bold")).pack(anchor=tk.W, pady=(0, 5))
        self.title_entry = ttk.Entry(left_frame, width=35, font=("Arial", 10))
        self.title_entry.pack(fill=tk.X, pady=(0, 10))

        # Поле Жанр
        ttk.Label(left_frame, text="Жанр:", font=("Arial", 10, "bold")).pack(anchor=tk.W, pady=(0, 5))
        self.genre_entry = ttk.Entry(left_frame, width=35, font=("Arial", 10))
        self.genre_entry.pack(fill=tk.X, pady=(0, 10))
        
        # Подсказка для жанра
        ttk.Label(left_frame, text="Примеры: Драма, Комедия, Боевик, Фэнтези", 
                  font=("Arial", 8), foreground="gray").pack(anchor=tk.W, pady=(0, 10))

        # Поле Год выпуска
        ttk.Label(left_frame, text="Год выпуска:", font=("Arial", 10, "bold")).pack(anchor=tk.W, pady=(0, 5))
        self.year_entry = ttk.Entry(left_frame, width=35, font=("Arial", 10))
        self.year_entry.pack(fill=tk.X, pady=(0, 10))

        # Поле Рейтинг
        ttk.Label(left_frame, text="Рейтинг (0-10):", font=("Arial", 10, "bold")).pack(anchor=tk.W, pady=(0, 5))
        self.rating_entry = ttk.Entry(left_frame, width=35, font=("Arial", 10))
        self.rating_entry.pack(fill=tk.X, pady=(0, 15))

        # Кнопка Добавить фильм
        self.add_button = ttk.Button(left_frame, text="➕ Добавить фильм", command=self.add_movie, width=30)
        self.add_button.pack(pady=(0, 5))

        # Кнопка Очистить поля
        self.clear_button = ttk.Button(left_frame, text="🗑 Очистить поля", command=self.clear_fields, width=30)
        self.clear_button.pack()

        # Статистика
        stats_frame = ttk.LabelFrame(left_frame, text="Статистика", padding="10")
        stats_frame.pack(fill=tk.X, pady=(15, 0))
        
        self.stats_label = ttk.Label(stats_frame, text="Фильмов в библиотеке: 0", font=("Arial", 10))
        self.stats_label.pack()
        
        self.avg_rating_label = ttk.Label(stats_frame, text="Средний рейтинг: 0", font=("Arial", 10))
        self.avg_rating_label.pack(pady=(5, 0))

        # ==================== Правая панель - Просмотр и фильтрация ====================
        right_frame = ttk.Frame(main_frame)
        right_frame.pack(side=tk.RIGHT, fill=tk.BOTH, expand=True)

        # Панель фильтрации
        filter_frame = ttk.LabelFrame(right_frame, text="Фильтрация фильмов", padding="10")
        filter_frame.pack(fill=tk.X, pady=(0, 10))

        # Фильтр по жанру
        genre_filter_frame = ttk.Frame(filter_frame)
        genre_filter_frame.pack(fill=tk.X, pady=(0, 10))
        
        ttk.Label(genre_filter_frame, text="Фильтр по жанру:", font=("Arial", 10)).pack(side=tk.LEFT, padx=(0, 10))
        self.genre_filter = ttk.Combobox(genre_filter_frame, values=self.genres, width=25, state="readonly")
        self.genre_filter.set("Все")
        self.genre_filter.pack(side=tk.LEFT, padx=(0, 10))
        self.genre_filter.bind("<<ComboboxSelected>>", lambda e: self.filter_movies())

        # Фильтр по году
        year_filter_frame = ttk.Frame(filter_frame)
        year_filter_frame.pack(fill=tk.X, pady=(0, 10))
        
        ttk.Label(year_filter_frame, text="Фильтр по году:", font=("Arial", 10)).pack(side=tk.LEFT, padx=(0, 10))
        
        # От года
        ttk.Label(year_filter_frame, text="от:").pack(side=tk.LEFT, padx=(0, 5))
        self.year_from = ttk.Entry(year_filter_frame, width=8)
        self.year_from.pack(side=tk.LEFT, padx=(0, 10))
        
        # До года
        ttk.Label(year_filter_frame, text="до:").pack(side=tk.LEFT, padx=(0, 5))
        self.year_to = ttk.Entry(year_filter_frame, width=8)
        self.year_to.pack(side=tk.LEFT, padx=(0, 10))
        
        # Кнопка применения фильтра по году
        self.apply_year_filter = ttk.Button(year_filter_frame, text="Применить", command=self.filter_movies, width=10)
        self.apply_year_filter.pack(side=tk.LEFT, padx=(0, 5))
        
        # Кнопка сброса всех фильтров
        self.reset_filters_btn = ttk.Button(filter_frame, text="Сбросить все фильтры", command=self.reset_filters)
        self.reset_filters_btn.pack(pady=(5, 0))

        # Таблица с фильмами
        table_frame = ttk.LabelFrame(right_frame, text="Список фильмов", padding="10")
        table_frame.pack(fill=tk.BOTH, expand=True)

        # Создание таблицы Treeview
        columns = ("title", "genre", "year", "rating", "added_date")
        self.tree = ttk.Treeview(table_frame, columns=columns, show="headings", height=15)
        
        # Настройка заголовков
        self.tree.heading("title", text="Название фильма")
        self.tree.heading("genre", text="Жанр")
        self.tree.heading("year", text="Год")
        self.tree.heading("rating", text="Рейтинг")
        self.tree.heading("added_date", text="Дата добавления")
        
        # Настройка ширины колонок
        self.tree.column("title", width=300)
        self.tree.column("genre", width=120)
        self.tree.column("year", width=80)
        self.tree.column("rating", width=80)
        self.tree.column("added_date", width=150)
        
        # Добавление скроллбаров
        scrollbar_y = ttk.Scrollbar(table_frame, orient=tk.VERTICAL, command=self.tree.yview)
        scrollbar_x = ttk.Scrollbar(table_frame, orient=tk.HORIZONTAL, command=self.tree.xview)
        self.tree.configure(yscrollcommand=scrollbar_y.set, xscrollcommand=scrollbar_x.set)
        
        self.tree.grid(row=0, column=0, sticky="nsew")
        scrollbar_y.grid(row=0, column=1, sticky="ns")
        scrollbar_x.grid(row=1, column=0, sticky="ew")
        
        table_frame.grid_rowconfigure(0, weight=1)
        table_frame.grid_columnconfigure(0, weight=1)
        
        # Кнопки управления
        btn_frame = ttk.Frame(right_frame)
        btn_frame.pack(fill=tk.X, pady=(10, 0))
        
        self.delete_button = ttk.Button(btn_frame, text="🗑 Удалить выбранный фильм", command=self.delete_movie)
        self.delete_button.pack(side=tk.LEFT, padx=(0, 5))
        
        self.edit_button = ttk.Button(btn_frame, text="✏ Редактировать фильм", command=self.edit_movie)
        self.edit_button.pack(side=tk.LEFT)
        
        # Статусная строка
        self.status_var = tk.StringVar()
        self.status_var.set(f"Готов к работе. Фильмов в библиотеке: {len(self.movies)}")
        status_bar = ttk.Label(self.root, textvariable=self.status_var, relief=tk.SUNKEN, anchor=tk.W)
        status_bar.pack(side=tk.BOTTOM, fill=tk.X)

        # Привязка событий
        self.tree.bind("<Double-1>", lambda e: self.edit_movie())

    def add_movie(self):
        """Добавление нового фильма"""
        # Получение данных из полей
        title = self.title_entry.get().strip()
        genre = self.genre_entry.get().strip()
        year_str = self.year_entry.get().strip()
        rating_str = self.rating_entry.get().strip()

        # Валидация
        if not title:
            messagebox.showerror("Ошибка", "Название фильма не может быть пустым!")
            return
        
        if not genre:
            messagebox.showerror("Ошибка", "Жанр не может быть пустым!")
            return
        
        # Проверка года
        try:
            year = int(year_str)
            current_year = datetime.now().year
            if year < 1888 or year > current_year:
                messagebox.showerror("Ошибка", f"Год должен быть от 1888 до {current_year}!")
                return
        except ValueError:
            messagebox.showerror("Ошибка", "Год должен быть числом!")
            return
        
        # Проверка рейтинга
        try:
            rating = float(rating_str)
            if rating < 0 or rating > 10:
                messagebox.showerror("Ошибка", "Рейтинг должен быть от 0 до 10!")
                return
        except ValueError:
            messagebox.showerror("Ошибка", "Рейтинг должен быть числом!")
            return

        # Проверка на дубликат
        for movie in self.movies:
            if movie["title"].lower() == title.lower() and movie["year"] == year:
                if messagebox.askyesno("Предупреждение", 
                                      f"Фильм '{title}' ({year}) уже существует в библиотеке.\n"
                                      "Хотите добавить его как отдельную запись?"):
                    pass
                else:
                    return

        # Создание записи
        movie = {
            "title": title,
            "genre": genre,
            "year": year,
            "rating": rating,
            "added_date": datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        }
        
        self.movies.append(movie)
        self.save_movies()
        
        # Обновление фильтров
        self.update_genres_list()
        
        # Очистка полей и обновление отображения
        self.clear_fields()
        self.display_movies()
        self.update_statistics()
        
        self.status_var.set(f"Фильм '{title}' успешно добавлен")
        messagebox.showinfo("Успех", f"Фильм '{title}' успешно добавлен!")

    def display_movies(self, movies_to_display=None):
        """Отображение фильмов в таблице"""
        # Очистка таблицы
        for item in self.tree.get_children():
            self.tree.delete(item)
        
        # Если передан отфильтрованный список, используем его, иначе все фильмы
        display_movies = movies_to_display if movies_to_display is not None else self.movies
        
        # Добавление фильмов в таблицу
        for movie in display_movies:
            self.tree.insert("", tk.END, values=(
                movie["title"],
                movie["genre"],
                movie["year"],
                f"{movie['rating']:.1f}",
                movie["added_date"]
            ))
        
        # Обновление статистики
        self.update_statistics(display_movies)

    def update_statistics(self, movies=None):
        """Обновление статистики"""
        if movies is None:
            movies = self.movies
        
        total = len(movies)
        self.stats_label.config(text=f"Фильмов в библиотеке: {total}")
        
        if total > 0:
            avg_rating = sum(m["rating"] for m in movies) / total
            self.avg_rating_label.config(text=f"Средний рейтинг: {avg_rating:.2f}")
        else:
            self.avg_rating_label.config(text="Средний рейтинг: 0")

    def filter_movies(self):
        """Фильтрация фильмов по жанру и году"""
        selected_genre = self.genre_filter.get()
        year_from_str = self.year_from.get().strip()
        year_to_str = self.year_to.get().strip()
        
        filtered_movies = self.movies.copy()
        
        # Фильтр по жанру
        if selected_genre != "Все":
            filtered_movies = [m for m in filtered_movies if m["genre"] == selected_genre]
        
        # Фильтр по году
        try:
            if year_from_str:
                year_from = int(year_from_str)
                filtered_movies = [m for m in filtered_movies if m["year"] >= year_from]
        except ValueError:
            if year_from_str:
                messagebox.showerror("Ошибка", "Неверный формат года 'от'!")
                return
        
        try:
            if year_to_str:
                year_to = int(year_to_str)
                filtered_movies = [m for m in filtered_movies if m["year"] <= year_to]
        except ValueError:
            if year_to_str:
                messagebox.showerror("Ошибка", "Неверный формат года 'до'!")
                return
        
        # Отображение отфильтрованных фильмов
        self.display_movies(filtered_movies)
        
        # Обновление статуса
        filter_info = []
        if selected_genre != "Все":
            filter_info.append(f"жанр: {selected_genre}")
        if year_from_str:
            filter_info.append(f"год ≥ {year_from_str}")
        if year_to_str:
            filter_info.append(f"год ≤ {year_to_str}")
        
        if filter_info:
            self.status_var.set(f"Найдено {len(filtered_movies)} фильмов ({', '.join(filter_info)})")
        else:
            self.status_var.set(f"Всего фильмов: {len(filtered_movies)}")

    def reset_filters(self):
        """Сброс всех фильтров"""
        self.genre_filter.set("Все")
        self.year_from.delete(0, tk.END)
        self.year_to.delete(0, tk.END)
        self.display_movies()
        self.status_var.set(f"Фильтры сброшены. Всего фильмов: {len(self.movies)}")

    def update_genres_list(self):
        """Обновление списка жанров для фильтрации"""
        self.genres = self.get_unique_genres()
        self.genre_filter['values'] = self.genres
        if self.genre_filter.get() not in self.genres:
            self.genre_filter.set("Все")

    def delete_movie(self):
        """Удаление выбранного фильма"""
        selected = self.tree.selection()
        if not selected:
            messagebox.showwarning("Предупреждение", "Выберите фильм для удаления!")
            return
        
        # Получение данных выбранного фильма
        item = self.tree.item(selected[0])
        values = item['values']
        
        # Поиск и удаление фильма
        for i, movie in enumerate(self.movies):
            if (movie["title"] == values[0] and 
                movie["genre"] == values[1] and 
                movie["year"] == values[2] and 
                f"{movie['rating']:.1f}" == values[3]):
                
                if messagebox.askyesno("Подтверждение", f"Удалить фильм '{movie['title']}' ({movie['year']})?"):
                    del self.movies[i]
                    self.save_movies()
                    self.update_genres_list()
                    self.display_movies()
                    self.update_statistics()
                    self.status_var.set(f"Фильм '{movie['title']}' удалён")
                    break

    def edit_movie(self):
        """Редактирование выбранного фильма"""
        selected = self.tree.selection()
        if not selected:
            messagebox.showwarning("Предупреждение", "Выберите фильм для редактирования!")
            return
        
        # Получение данных выбранного фильма
        item = self.tree.item(selected[0])
        values = item['values']
        
        # Поиск фильма для редактирования
        for i, movie in enumerate(self.movies):
            if (movie["title"] == values[0] and 
                movie["genre"] == values[1] and 
                movie["year"] == values[2] and 
                f"{movie['rating']:.1f}" == values[3]):
                
                # Создание окна редактирования
                edit_window = tk.Toplevel(self.root)
                edit_window.title("Редактирование фильма")
                edit_window.geometry("450x400")
                edit_window.resizable(False, False)
                edit_window.transient(self.root)
                edit_window.grab_set()
                
                # Поля для редактирования
                ttk.Label(edit_window, text="Название фильма:", font=("Arial", 10, "bold")).pack(pady=(15, 5))
                title_edit = ttk.Entry(edit_window, width=40, font=("Arial", 10))
                title_edit.insert(0, movie["title"])
                title_edit.pack(pady=(0, 10))
                
                ttk.Label(edit_window, text="Жанр:", font=("Arial", 10, "bold")).pack(pady=(5, 5))
                genre_edit = ttk.Entry(edit_window, width=40, font=("Arial", 10))
                genre_edit.insert(0, movie["genre"])
                genre_edit.pack(pady=(0, 10))
                
                ttk.Label(edit_window, text="Год выпуска:", font=("Arial", 10, "bold")).pack(pady=(5, 5))
                year_edit = ttk.Entry(edit_window, width=40, font=("Arial", 10))
                year_edit.insert(0, str(movie["year"]))
                year_edit.pack(pady=(0, 10))
                
                ttk.Label(edit_window, text="Рейтинг (0-10):", font=("Arial", 10, "bold")).pack(pady=(5, 5))
                rating_edit = ttk.Entry(edit_window, width=40, font=("Arial", 10))
                rating_edit.insert(0, str(movie["rating"]))
                rating_edit.pack(pady=(0, 15))
                
                def save_edit():
                    # Валидация
                    new_title = title_edit.get().strip()
                    new_genre = genre_edit.get().strip()
                    new_year_str = year_edit.get().strip()
                    new_rating_str = rating_edit.get().strip()
                    
                    if not new_title:
                        messagebox.showerror("Ошибка", "Название не может быть пустым!")
                        return
                    
                    if not new_genre:
                        messagebox.showerror("Ошибка", "Жанр не может быть пустым!")
                        return
                    
                    try:
                        new_year = int(new_year_str)
                        current_year = datetime.now().year
                        if new_year < 1888 or new_year > current_year:
                            messagebox.showerror("Ошибка", f"Год должен быть от 1888 до {current_year}!")
                            return
                    except ValueError:
                        messagebox.showerror("Ошибка", "Год должен быть числом!")
                        return
                    
                    try:
                        new_rating = float(new_rating_str)
                        if new_rating < 0 or new_rating > 10:
                            messagebox.showerror("Ошибка", "Рейтинг должен быть от 0 до 10!")
                            return
                    except ValueError:
                        messagebox.showerror("Ошибка", "Рейтинг должен быть числом!")
                        return
                    
                    # Обновление фильма
                    movie["title"] = new_title
                    movie["genre"] = new_genre
                    movie["year"] = new_year
                    movie["rating"] = new_rating
                    
                    self.save_movies()
                    self.update_genres_list()
                    self.display_movies()
                    self.update_statistics()
                    edit_window.destroy()
                    self.status_var.set(f"Фильм '{new_title}' успешно обновлён")
                    messagebox.showinfo("Успех", "Фильм успешно обновлён!")
                
                ttk.Button(edit_window, text="💾 Сохранить", command=save_edit).pack(pady=(10, 5))
                ttk.Button(edit_window, text="❌ Отмена", command=edit_window.destroy).pack()
                
                break

    def clear_fields(self):
        """Очистка полей ввода"""
        self.title_entry.delete(0, tk.END)
        self.genre_entry.delete(0, tk.END)
        self.year_entry.delete(0, tk.END)
        self.rating_entry.delete(0, tk.END)

def main():
    root = tk.Tk()
    app = MovieLibrary(root)
    root.mainloop()

if __name__ == "__main__":
    main()
